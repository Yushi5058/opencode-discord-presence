{
  "name": "@yushi_61/opencode-discord-presence",
  "version": "0.8.1",
  "description": "Discord Rich Presence plugin for OpenCode V1 and V2 - Display your current AI agent, model, and status in Discord",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "discord",
    "rich-presence",
    "rpc",
    "ai",
    "plugin"
  ],
  "author": "Puri12",
  "contributors": [
    "Yushi5058 (V2 support maintainer, npm scope yushi_61)",
    "Muhammad Rheza Alfin (vheins) (original V2 adapter)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yushi5058/opencode-discord-presence.git"
  },
  "bugs": {
    "url": "https://github.com/Yushi5058/opencode-discord-presence/issues"
  },
  "homepage": "https://github.com/Yushi5058/opencode-discord-presence#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@opencode-ai/plugin": "^1.16.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
